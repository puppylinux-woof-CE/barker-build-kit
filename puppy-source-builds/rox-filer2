#!/bin/bash

cd /tmp

WORKDIR=$(mktemp -d)

cd "$WORKDIR"

echo "Downloading sources..."

# rox-filer2 (main branch)
wget -O rox2.zip \
  https://github.com/josejp2424/ROX-Filer2/archive/refs/heads/main.zip

echo "Extracting..."
unzip rox2.zip

echo "Building rox-filer2..."
cd "ROX-Filer2-main"
#meson --buildtype=release --prefix=/usr/local --bindir=/usr/local/bin build

./build-package.sh

OUTDIR="$(find ./ -type d -name "*-portable-*" 2>/dev/null | head -n 1 2>/dev/null)"

if [ "$OUTDIR" != "" ]; then
  echo "Copying  $OUTDIR/usr to /usr/local ..."
  cp -rf $OUTDIR/usr/* /usr/local/
fi

cd /tmp

rm -rf ${WORKDIR}
