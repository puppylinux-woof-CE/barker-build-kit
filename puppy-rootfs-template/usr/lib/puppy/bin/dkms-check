#!/bin/bash
#concepted by mistfire

if [ "$(id -u)" -ne 0 ]; then
    echo "Error: This script must be run as root (sudo)." >&2
    exit 1
fi

KERNEL_VERSION=$(uname -r)

ARGS="$1"

[ ! -d /var/hwdata ] && mkdir -p /var/hwdata

if [ ! -f /var/hwdata/kernel.lst ]; then
  echo "$KERNEL_VERSION" > /var/hwdata/kernel.lst
else

  LASTKVER="$(cat /var/hwdata/kernel.lst | xargs)"
  
  if [ "$LASTKVER" == "$KERNEL_VERSION" ]; then
   [ "$ARGS" == "" ] && exit 1
  fi
  
fi

MODULES_DIR="/lib/modules/$KERNEL_VERSION"

echo "=================================================="
echo "Checking DKMS modules for kernel: $KERNEL_VERSION"
echo "=================================================="

#Scan for registered dkms modules
dkms status | while read -r line; do

    #Skip empty lines
    [ -z "$line" ] && continue

    # Parse module name and version using standard 'cut' and 'tr'
    MODULE_NAME=$(echo "$line" | cut -d'/' -f1)
    MODULE_VER=$(echo "$line" | cut -d'/' -f2  | cut -f 1 -d ':' | cut -d',' -f1 | tr -d ' ')

    echo "Found registered module: $MODULE_NAME ($MODULE_VER)"

    # Fast check using standard file testing
    # DKMS modules live either in 'updates/dkms' or 'dkms' subfolders
    MODULE_FOUND=0
    
    # Check if any matching .ko file exists in the standard DKMS paths
    # We loop over the wildcard match; if a file exists, the loop runs instantly
    
    DKMS_FILE=$(file $MODULES_DIR/updates/dkms/)
    
    for DKMS_MOD_DIR in $MODULES_DIR/updates/dkms $MODULES_DIR/dkms
    do
    
       DFOUND=$(find $DKMS_MOD_DIR -type f -name "${MODULE_NAME}.ko*" -print -quit 2>/dev/null | xargs)
       
       if [ "$DFOUND" != "" ]; then
            MODULE_FOUND=1
            break       
       fi
       
    done
    

    if [ "$MODULE_FOUND" -eq 1 ]; then
        echo "  -> Status: OK (Compiled module found)"
    else
        echo "  -> Status: MISSING"
        echo "  -> Action: Starting compilation in the background..."

        #Compile
        LOG_FILE="/var/log/dkms_auto_compile_${MODULE_NAME}.log"
        
		echo "Starting DKMS build/install for $MODULE_NAME/$MODULE_VER at $(date)" > "$LOG_FILE"
		
		dkms build -m "$MODULE_NAME" -v "$MODULE_VER" -k "$KERNEL_VERSION" >> "$LOG_FILE" 2>&1 && \
		dkms install -m "$MODULE_NAME" -v "$MODULE_VER" -k "$KERNEL_VERSION" >> "$LOG_FILE" 2>&1
		
		if [ $? -eq 0 ]; then
			echo "Successfully installed $MODULE_NAME for $KERNEL_VERSION" >> "$LOG_FILE"
		else
			echo "FAILED to install $MODULE_NAME for $KERNEL_VERSION. Check $LOG_FILE" >> "$LOG_FILE"
		fi

    fi
    
    echo "--------------------------------------------------"
    
done

echo "Scan complete."
