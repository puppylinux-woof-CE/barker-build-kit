#!/bin/bash
#concepted by mistfire

if [ "$(id -u)" -ne 0 ]; then
    echo "Error: This script must be run as root (sudo)."
    exit 1
fi

if [ "$(which gcc)" == "" ]; then
   echo "Error: gcc compiler is missing"
   exit 1
fi

KERNEL_VERSION=$(uname -r)

ARGS="$1"

[ ! -d /var/hwdata ] && mkdir -p /var/hwdata

if [ ! -f /var/hwdata/kernel.lst ]; then
  echo "$KERNEL_VERSION" > /var/hwdata/kernel.lst
else

  LASTKVER="$(cat /var/hwdata/kernel.lst | xargs)"
  
  if [ "$LASTKVER" == "$KERNEL_VERSION" ]; then
   [ "$ARGS" == "" ] && exit 1
  else
   echo "$KERNEL_VERSION" > /var/hwdata/kernel.lst
  fi
  
fi

MODULES_DIR="/lib/modules/$KERNEL_VERSION"

echo "=================================================="
echo "Checking DKMS modules for kernel: $KERNEL_VERSION"
echo "=================================================="

#Scan for registered dkms modules
for dkmod in $(ls /var/lib/dkms 2>/dev/null | tr '\n' ' ')
do

    #Skip empty lines
    [ -z "$dkmod" ] && continue
    
    echo "-> DKMS module: $dkmod"
    
    MODULE_FOUND=1
    
    DKMS_LINE="$(dkms status -m $dkmod -k $KERNEL_VERSION)"

	if [ "$(echo $DKMS_LINE | grep -E "added|built")" != "" ]; then
	  MODULE_FOUND=0
      MODULE_NAME=$(echo $DKMS_LINE | cut -f 1 -d '/')
      MODULE_VER=$(echo $DKMS_LINE | cut -f 2 -d '/' | cut -f 1 -d ',' | cut -f 1 -d ':')
    elif [ "$(echo $DKMS_LINE | grep "installed" | grep "Diff")" != "" ]; then
	  MODULE_FOUND=0
      MODULE_NAME=$(echo $DKMS_LINE | cut -f 1 -d '/')
      MODULE_VER=$(echo $DKMS_LINE | cut -f 2 -d '/' | cut -f 1 -d ',' | cut -f 1 -d ':')
    fi
    
    
    if [ "$MODULE_FOUND" -eq 1 ]; then
        echo "  -> Status: OK (Compiled module found)"
    else
        echo "  -> Status: MISSING"
        echo "  -> Action: Starting compilation in the background..."

        #Compile
        
        [ ! -d /var/log/dkms-autobuild ] && mkdir -p /var/log/dkms-autobuild
        
        LOG_FILE="/var/log/dkms-autobuild/dkms_${MODULE_NAME}.log"
        
		echo "Starting DKMS build/install for $MODULE_NAME/$MODULE_VER at $(date)" > "$LOG_FILE"
		
		dkms build -m "$MODULE_NAME" -v "$MODULE_VER" -k "$KERNEL_VERSION" >> "$LOG_FILE" 2>&1
		[ $? -eq 0 ] && dkms install -m "$MODULE_NAME" -v "$MODULE_VER" -k "$KERNEL_VERSION" --force >> "$LOG_FILE" 2>&1
		
		if [ $? -eq 0 ]; then
			echo "Successfully installed $MODULE_NAME for $KERNEL_VERSION" >> "$LOG_FILE"
		else
			echo "FAILED to install $MODULE_NAME for $KERNEL_VERSION. Check $LOG_FILE" >> "$LOG_FILE"
		fi

    fi
    
    echo "--------------------------------------------------"
    
done

echo "Scan complete."
