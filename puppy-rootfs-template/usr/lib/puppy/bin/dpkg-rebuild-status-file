#!/bin/bash

SRC_DIR="/var/lib/dpkg/installed"
OUT_FILE="/var/lib/dpkg/status.rebuilt"
TMP_FILE="$(mktemp)"

[ -d "$SRC_DIR" ] || {
    echo "Missing directory: $SRC_DIR" >&2
    exit 1
}

find /var/lib/dpkg/installed -type f -print0 |
while IFS= read -r -d '' file; do

    bname=${file##*/}

    if [ -f "/var/lib/dpkg/info/${bname}.list" ] ||
       ls /var/lib/dpkg/info/"${bname}":* >/dev/null 2>&1; then
        continue
    fi

    rm -f "${SRC_DIR}/$bname"

done

# Single pass over all files (no per-file grep/awk)
awk '
FNR==1 {
    valid=0
    started=0
}

# Detect valid package file
/^Package: / { valid=1 }

# Skip leading blank lines
{
    if (!valid) next
    if (!started && $0=="") next
    started=1
    print
}

# Add separator between files
ENDFILE {
    if (valid && started) print ""
}
' "$SRC_DIR"/* > "$TMP_FILE"

# Atomic replace
mv -f /var/lib/dpkg/status /var/lib/dpkg/status-old
mv -f "$TMP_FILE" "$OUT_FILE"
mv -f "$OUT_FILE" /var/lib/dpkg/status
