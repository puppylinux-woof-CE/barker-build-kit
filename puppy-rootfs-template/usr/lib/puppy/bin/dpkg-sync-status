#!/bin/bash

STATUS_FILE="/var/lib/dpkg/status"
OUT_DIR="/var/lib/dpkg/installed"

mkdir -p "$OUT_DIR"

# Extract package names from dpkg status
mapfile -t status_pkgs < <(
    awk -F': ' '/^Package:/ {print $2}' "$STATUS_FILE"
)

# Extract package names from existing split files
mapfile -t installed_pkgs < <(
    awk -F': ' '/^Package:/ {print $2}' "$OUT_DIR"/* 2>/dev/null
)

# Build unique list (symmetric difference)
unique_pkgs=$(printf "%s\n" "${status_pkgs[@]}" "${installed_pkgs[@]}" | sort | uniq -u)

# Process each package
for pkg in $unique_pkgs
do

    [ -z "$pkg" ] && continue

    if grep -q "^Package: $pkg$" "$STATUS_FILE"; then
        dpkg-query -s "$pkg" > "$OUT_DIR/$pkg"
    else
        [ -f "$OUT_DIR/$pkg" ] && rm -f "$OUT_DIR/$pkg"
    fi

done
