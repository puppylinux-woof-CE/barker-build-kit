#!/bin/bash

FILEPATH="$1"

[ "$FILEPATH" == "" ] && exit
[ "$(basename "$FILEPATH")" != "dkms.conf" ] && exit 
[ ! -f "$FILEPATH" ] && exit
[ "$(which dkms)" == "" ] && exit

. "$FILEPATH"

dkms add -m $PACKAGE_NAME -v $PACKAGE_VERSION

#remove old version
dkms status -m $PACKAGE_NAME -k $(uname -r) | while read -r line; do

    version=$(echo "$line" | head -n 1 | cut -f 2 -d '/' | cut -f 1 -d ',' | cut -f 1 -d ':')

    versions=$(dkms -m $PACKAGE_NAME -k $(uname -r) | \
        cut -f 2 -d '/' | \
        cut -f 1 -d ',' | \  
        cut -f 1 -d ':'  | \
        sort -V | uniq)
            
    latest=$(echo "$versions" | tail -n1)
    
    if [ "$latest" != "" ] && [ "$version" != "$latest" ]; then
        echo "Removing old DKMS module: $module/$version"
        dkms remove "$PACKAGE_NAME/$version" --all
    fi
    
done
