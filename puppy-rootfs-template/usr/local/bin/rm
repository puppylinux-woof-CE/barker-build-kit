#!/bin/bash

DANGER_FOUND=0

normalize_path() {
    # collapse multiple slashes
    echo "$1" | sed -E 's:/+:/:g'
}

resolve_path() {
    # canonicalize even if path does not exist
    realpath -m -- "$1" 2>/dev/null
}

for arg in "$@"; do

    # skip options (rm flags)
    case "$arg" in
        -*) continue ;;
    esac

    norm="$(normalize_path "$arg")"
    resolved="$(resolve_path "$norm")"

    # fallback if realpath fails
    [ -z "$resolved" ] && resolved="$norm"
    
    depth=$(echo "$resolved" | grep -o "/" | wc -l)

    case "$resolved" in
        /)
            [ $depth -eq 1 ] && DANGER_FOUND=1
        ;;
        /dev|/sys|/proc|/mnt|/media|/run/media|/initrd|/run/initramfs|/initrd/mnt|/run/initramfs/mnt|/run/user/[0-9]*/gvfs)
            DANGER_FOUND=1
        ;;
        /mnt/*)
            if [ $depth -eq 2 ]; then
               [ "$(mount | awk '{ print $3 '} | grep -m 1 $resolved)" != "" ] && DANGER_FOUND=1
            fi
        ;;
        /media/*)
            if [ $depth -eq 2 ]; then
               [ "$(mount | awk '{ print $3 '} | grep -m 1 $resolved)" != "" ] && DANGER_FOUND=1
            fi
        ;;
        /run/media/*)
            if [ $depth -eq 3 ]; then
               [ "$(mount | awk '{ print $3 '} | grep -m 1 $resolved)" != "" ] && DANGER_FOUND=1
            fi
        ;;
        /initrd/*)
            if [ $depth -eq 2 ]; then
               [ "$(mount | awk '{ print $3 '} | grep -m 1 $resolved)" != "" ] && DANGER_FOUND=1
            fi
        ;;
        /initrd/mnt/*)
            if [ $depth -eq 3 ]; then
               [ "$(mount | awk '{ print $3 '} | grep -m 1 $resolved)" != "" ] && DANGER_FOUND=1
            fi
        ;;            
        /run/initramfs/*)
            if [ $depth -eq 3 ]; then
               [ "$(mount | awk '{ print $3 '} | grep -m 1 $resolved)" != "" ] && DANGER_FOUND=1
            fi
        ;;
        /run/initramfs/mnt/*)
            if [ $depth -eq 4 ]; then
               [ "$(mount | awk '{ print $3 '} | grep -m 1 $resolved)" != "" ] && DANGER_FOUND=1
            fi
        ;;            
        /run/user/[0-9]*/gvfs/*)
            if [ $depth -eq 5 ]; then
               [ "$(mount | awk '{ print $3 '} | grep -m 1 $resolved)" != "" ] && DANGER_FOUND=1
            fi
        ;;
    esac

    [ "$DANGER_FOUND" -ne 0 ] && break
    
done


if [ "$DANGER_FOUND" -ne 0 ]; then
    echo "dangerous rm usage blocked"
    exit 1
fi


# execute real rm
if [ -x /usr/bin/rm ]; then
    exec /usr/bin/rm "$@"
elif [ -x /bin/rm ]; then
    exec /bin/rm "$@"
elif [ -x /bin/busybox ]; then
    exec /bin/busybox rm "$@"
else
    echo "rm not found"
    exit 1
fi
